# Пример конфигурации pg-backup
# Скопируйте файл (например, в /etc/pg-backup.conf), заполните значения
# и запускайте скрипт:  pg-backup.sh --config /etc/pg-backup.conf
#
# Формат: KEY=VALUE, по одному на строку. Без кавычек. Комментарии — #.
# Файл должен быть доступен только владельцу (chmod 600): в нём пароль.

# --- Подключение к PostgreSQL ---------------------------------------------
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=backup
# Пароль можно задать здесь, но безопаснее — файл .pgpass.
# .pgpass находится через окружение (HOME или PGPASSFILE), НЕ через конфиг:
#   ~/.pgpass  (формат: хост:порт:база:пользователь:пароль, права 600)
PGPASSWORD=change-me
# Таймаут подключения, секунд
PGCONNECT_TIMEOUT=10

# --- Какие базы копировать --------------------------------------------------
# Пусто = автоматически все пользовательские базы (кроме EXCLUDE_DBS).
# Явный список через пробел:
#DB_LIST=orders users logs
# Исключаемые базы (по умолчанию — служебные шаблоны):
EXCLUDE_DBS=template0 template1

# --- Каталоги и лимиты ------------------------------------------------------
# Куда переносить готовые архивы (отдельный диск):
BACKUP_DIR=/var/backups/pg
# Рабочий каталог для дампов. Пусто = автоматический временный (mktemp -d).
WORK_DIR=
# Минимум свободного места, МБ, на каждом диске (рабочем и целевом),
# иначе скрипт откажется работать:
MIN_FREE_SPACE_MB=512
# Лог-файл (права 600 создаёт сам скрипт):
LOG_FILE=/var/log/pg-backup.log
